NODE_ENV=development
PORT=3001

# PostgreSQL — used when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=vijayagarwal
DB_PASSWORD=
DB_NAME=krishnabyrr_dev

# Override entire connection string (takes precedence over individual vars above)
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Firebase Admin SDK — push notifications for the mobile app
# Copy values from krishna-s-bliss-firebase-adminsdk-*.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key including header/footer; literal \n is fine in .env
FIREBASE_PRIVATE_KEY=

# On-demand cache revalidation — must match REVALIDATE_SECRET in apps/web/.env.production
REVALIDATE_SECRET=change-me-in-production
# URL of the Next.js web app (used by the API to call the revalidation endpoint)
WEB_ORIGIN=http://localhost:3000
